# /etc/ppc64-diag/diag_fc.config
# Fibre Channel adapter failure evidence collector configuration
#
# diag_fc is a passive evidence collector invoked by an external component
# (EEH subsystem, platform firmware) after a permanent FC adapter failure.
# It does not monitor FC health, detect failures, or run continuously.
#
# This file is optional.  diag_fc will function correctly if it is absent.

# Maximum report size in kilobytes.
# diag_fc will emit a warning to stderr if the written report exceeds this
# size, but will never truncate the file (truncated JSON is not valid JSON).
# Requires testing to confirm behaviour at small (< 10) and large (> 65536) values.
MAX_REPORT_SIZE_KB = 4096

# Collect dm-multipath device information backed by this FC adapter.
# Set to 0 to skip mpath collection (useful when dm-multipath is not in use).
mpath_enabled = 1
