# Fibre Channel Call Home Configuration
# This file configures thresholds and monitoring options for diag_fc

# Thresholds for error detection
# Values are used to determine when to log WARNING or ERROR events

# Link error thresholds
LINK_FAILURE_RATE = 10          # failures per hour
INVALID_CRC_RATE = 100          # per million frames
LOSS_OF_SYNC_RATE = 5           # per hour
LOSS_OF_SIGNAL_RATE = 5         # per hour
ERROR_FRAME_RATE = 0.01         # percentage of total frames

# Multipath thresholds
MULTIPATH_MIN_PATHS = 1         # minimum active paths before alert
MULTIPATH_DEGRADED_ALERT = 1    # alert on any path failure (1=yes, 0=no)

# Performance thresholds
THROUGHPUT_DROP_PERCENT = 50    # alert if throughput drops by this %
MIN_SPEED_GBPS = 16             # alert if speed below this (16/32/64)

# Monitoring features (1=enabled, 0=disabled)
PORT_STATE_CHANGE = 1           # Monitor port state changes (critical)
LINK_ERRORS = 1                 # Monitor CRC errors, link failures (critical)
MULTIPATH_DEGRADATION = 1       # Monitor multipath health (critical)
EEH_EVENTS = 1                  # Monitor EEH events - PowerPC-specific (critical)
PERFORMANCE_ANOMALY = 1         # Monitor performance drops (informational)
TOPOLOGY_CHANGES = 0            # Monitor fabric changes (informational, can be noisy)

# ServiceLog integration
ENABLE_LOGGING = 1              # Enable servicelog integration
DUPLICATE_CHECK = 1             # Check for duplicate events
DUPLICATE_WINDOW = 3600         # seconds to check for duplicates